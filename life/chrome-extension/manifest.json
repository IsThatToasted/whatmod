{
  "manifest_version": 3,
  "name": "Add to JustGlance",
  "version": "1.3.0",
  "description": "Save products to JustGlance on demand with quiet, retailer-aware extraction and one-click pairing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://whatmod.com/life/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://whatmod.com/life/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://whatmod.com/life/*"
      ],
      "js": [
        "product-parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Add to JustGlance"
  }
}
